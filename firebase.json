{
  "hosting": {
    "public": "website/public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**/*.@(js|css|png|jpg|svg|webp|avif)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/privacy.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
